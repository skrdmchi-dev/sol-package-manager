#!/usr/bin/env bash
#
# mlfs-snapshot — filesystem snapshots + rollback for the MLFS system
#
# Uses rsync --link-dest so each snapshot hard-links unchanged files from the
# previous one: near-instant creates and small disk usage on ext4.
#
# Commands:
#   snapshot create [name]      take a snapshot now
#   snapshot list               list snapshots (newest last)
#   snapshot last [--boot]      restore newest snapshot — now, or at next boot
#   snapshot restore <id> [--boot]
#   snapshot delete <id>        remove one snapshot
#   snapshot prune              keep only the newest 3 snapshots
#   snapshot status             show counts, latest, pending rollback
#
set -euo pipefail

SNAP_ROOT="/var/lib/mlfs-snapshots"
PENDING="$SNAP_ROOT/PENDING_ROLLBACK"
KEEP=3
DIRS=(usr etc opt)          # top-level dirs covered by snapshots
RSYNC="/nix/var/nix/profiles/per-user/root/profile/bin/rsync"
command -v "$RSYNC" >/dev/null || RSYNC=rsync

log()  { printf '\033[1;36m[snapshot]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[snapshot]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[snapshot]\033[0m %s\n' "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "run as root (sudo snapshot ...)"

latest_id() { ls -d "$SNAP_ROOT"/[0-9]* 2>/dev/null | xargs -n1 basename 2>/dev/null | sort | tail -1; }

valid_id() { [[ "$1" =~ ^[0-9]{8}-[0-9]{6}([._-][A-Za-z0-9._-]+)?$ ]]; }

newest_linkdest() {
    local want="$1" prev
    for prev in $(ls -d "$SNAP_ROOT"/[0-9]* 2>/dev/null | sort -r); do
        [[ -d "$prev/$want" ]] && { echo "$prev/$want"; return; }
    done
}

cmd_create() {
    local name="${1:-manual}" id d link
    id="$(date +%Y%m%d-%H%M%S)"
    [[ -n "$name" ]] && id="$id-$name"
    mkdir -p "$SNAP_ROOT/$id"
    for d in "${DIRS[@]}"; do
        [[ -d "/$d" ]] || continue
        mkdir -p "$SNAP_ROOT/$id/$d"
        link="$(newest_linkdest "$d" || true)"
        if [[ -n "$link" && "$link" != "$SNAP_ROOT/$id/$d" ]]; then
            "$RSYNC" -aAXH --delete --link-dest="$link" "/$d/" "$SNAP_ROOT/$id/$d/"
        else
            "$RSYNC" -aAXH --delete "/$d/" "$SNAP_ROOT/$id/$d/"
        fi
    done
    date --iso-8601=seconds > "$SNAP_ROOT/$id/created"
    echo "$name" > "$SNAP_ROOT/$id/name"
    touch "$SNAP_ROOT/$id/.mlfs-snapshot"
    log "created $id"
    cmd_prune
}

do_restore() {
    local id="$1" d
    valid_id "$id" || die "bad snapshot id: $id"
    [[ -f "$SNAP_ROOT/$id/.mlfs-snapshot" ]] || die "no such snapshot: $id"
    log "restoring $id ..."
    for d in "${DIRS[@]}"; do
        [[ -d "$SNAP_ROOT/$id/$d" ]] || continue
        "$RSYNC" -aAXH --delete "$SNAP_ROOT/$id/$d/" "/$d/"
    done
    ldconfig 2>/dev/null || true
    log "restore complete — $id is now live"
}

cmd_last() {
    local boot="${1:-}" id
    id="$(latest_id)"; [[ -n "$id" ]] || die "no snapshots exist"
    if [[ "$boot" == "--boot" ]]; then
        echo "$id" > "$PENDING"
        log "rollback to $id scheduled — takes effect at next boot"
    else
        do_restore "$id"
    fi
}

cmd_restore() {
    local id="${1:?usage: snapshot restore <id> [--boot]}" boot="${2:-}"
    if [[ "$boot" == "--boot" ]]; then
        valid_id "$id" || die "bad snapshot id"
        [[ -f "$SNAP_ROOT/$id/.mlfs-snapshot" ]] || die "no such snapshot: $id"
        echo "$id" > "$PENDING"
        log "rollback to $id scheduled — takes effect at next boot"
    else
        do_restore "$id"
    fi
}

cmd_list() {
    mkdir -p "$SNAP_ROOT"
    local s
    shopt -s nullglob
    for s in "$SNAP_ROOT"/[0-9]*; do
        [[ -f "$s/.mlfs-snapshot" ]] || continue
        printf '%-28s %s\n' "$(basename "$s")" "$(cat "$s/name" 2>/dev/null)"
    done
}

cmd_delete() {
    local id="${1:?usage: snapshot delete <id>}"
    valid_id "$id" || die "bad snapshot id"
    [[ -d "$SNAP_ROOT/$id" ]] || die "no such snapshot: $id"
    rm -rf "${SNAP_ROOT:?}/$id"
    log "deleted $id"
}

cmd_prune() {
    local snaps n del i
    mapfile -t snaps < <(ls -d "$SNAP_ROOT"/[0-9]* 2>/dev/null | sort)
    n=${#snaps[@]}
    (( n > KEEP )) || return 0
    del=$(( n - KEEP ))
    for (( i=0; i<del; i++ )); do
        log "pruning old snapshot $(basename "${snaps[$i]}")"
        rm -rf "${snaps[$i]}"
    done
}

cmd_status() {
    mkdir -p "$SNAP_ROOT"
    log "snapshots dir : $SNAP_ROOT"
    log "count         : $(ls -d "$SNAP_ROOT"/[0-9]* 2>/dev/null | wc -l) (keep $KEEP)"
    log "latest        : $(latest_id || echo none)"
    [[ -f "$PENDING" ]] && log "PENDING rollback at boot: $(cat "$PENDING")"
    du -sh "$SNAP_ROOT" 2>/dev/null | awk '{printf "[snapshot] disk use      : %s\n",$1}'
}

case "${1:-}" in
    create)   shift; cmd_create "$@" ;;
    list|ls)  cmd_list ;;
    last)     cmd_last "${2:-}" ;;
    restore)  cmd_restore "${2:-}" "${3:-}" ;;
    delete|rm) cmd_delete "${2:-}" ;;
    prune)    cmd_prune ;;
    status)   cmd_status ;;
    boot-apply) # internal: invoked by mlfs-rollback.service
        [[ -f "$PENDING" ]] || exit 0
        id="$(cat "$PENDING")"
        if valid_id "$id" && [[ -f "$SNAP_ROOT/$id/.mlfs-snapshot" ]]; then
            do_restore "$id"
            rm -f "$PENDING"
            logger -t mlfs-snapshot "boot-time rollback to $id completed"
        else
            warn "pending rollback target $id missing — clearing flag"
            rm -f "$PENDING"
            exit 1
        fi ;;
    *) sed -n '2,20p' "$0" | sed 's/^#\s\?//'; exit "${1:+1}" ;;
esac
